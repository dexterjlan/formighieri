# Copie este arquivo para scripts/backup-prod-db.env e preencha a URL.
#   cp scripts/backup-prod-db.env.example scripts/backup-prod-db.env
#
# No Supabase de PRODUÇÃO:
#   Project Settings → Database → Connect → Session pooler (porta 5432, IPv4)
# A conexão Direct (db.<ref>.supabase.co) é só IPv6 e não funciona neste Mac.
# Não use o pooler na porta 6543 (Transaction) — o pg_dump falha ou gera dump incompleto.

SUPABASE_DB_URL_PROD='postgresql://postgres.[PROJECT_REF]:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres'

# Banco de DESENVOLVIMENTO (para testar restore sem mexer na prod)
SUPABASE_DB_URL_DEV='postgresql://postgres.[PROJECT_REF_DEV]:[SENHA_DEV]@db.[PROJECT_REF_DEV].supabase.co:5432/postgres'

# Região AWS do projeto (usada se a URL for Direct IPv6)
SUPABASE_POOLER_REGION='aws-1-sa-east-1'
SUPABASE_POOLER_REGION_DEV='aws-1-sa-east-1'

# Pasta dos arquivos de backup (criada automaticamente)
BACKUP_DIR="$HOME/Formighieri/backups/prod-db"

# Quantos dias manter os dumps antigos
BACKUP_KEEP_DAYS=14

# Após o dump: restaurar no DEV (schema prod_backup) e conferir COUNT(*) por tabela.
# 1 = sim (padrão)  |  0 = só o dump
VERIFY_RESTORE_DEV=1
RESTORE_DEV_SCHEMA=prod_backup
